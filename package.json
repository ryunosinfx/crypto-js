{
	"name": "crypto-js",
	"title": "crypto-js",
	"description": "JavaScript library of crypto standards.",
	"version": "4.2.0",
	"homepage": "http://github.com/brix/crypto-js",
	"author": {
		"name": "Evan Vosberg",
		"url": "http://github.com/evanvosberg"
	},
	"repository": {
		"type": "git",
		"url": "http://github.com/brix/crypto-js.git"
	},
	"bugs": {
		"url": "http://github.com/brix/crypto-js/issues"
	},
	"license": "MIT",
	"scripts": {
		"build": "grunt build",
		"test": "grunt default",
		"terser": "terser ./src/united/crypto.min.js --compress ecma=2016,computed_props=false -o ./src/united/crypto.m.js",
		"terser-sha1": "terser ./src/separated/sha1.min.js --compress ecma=2016,computed_props=false -o ./src/separated/sha1.m.js"
	},
	"main": "index.js",
	"browser": {
		"crypto": false
	},
	"dependencies": {
		"terser": "^5.44.0"
	},
	"keywords": [
		"security",
		"crypto",
		"Hash",
		"MD5",
		"SHA1",
		"SHA-1",
		"SHA256",
		"SHA-256",
		"RC4",
		"Rabbit",
		"AES",
		"DES",
		"PBKDF2",
		"HMAC",
		"OFB",
		"CFB",
		"CTR",
		"CBC",
		"Base64",
		"Base64url"
	]
}
